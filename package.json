{
  "name": "dotstories",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "node scripts/patch-opennext.mjs && opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare preview",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:blog": "node --test blog/blog.test.mjs",
    "blog:build": "node blog/build.mjs",
    "blog:preview": "node blog/build.mjs && wrangler dev -c blog/wrangler.jsonc",
    "bundle:check": "node scripts/check-bundle.mjs",
    "preview": "node scripts/patch-opennext.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/patch-opennext.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint:react": "react-doctor . --blocking warning --offline --verbose --yes --no-ami",
    "db:migrate:local": "node scripts/dev-vars.mjs && wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@carbon/icons-react": "^11.80.0",
    "@carbon/react": "^1.110.0",
    "@opennextjs/cloudflare": "^1.20.11",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "^19",
    "server-only": "^0.0.1",
    "zod": "^4",
    "zustand": "^5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/jest": "^30",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jest": "^30",
    "jest-environment-jsdom": "^30",
    "react-doctor": "0.9.18",
    "sass": "^1.90.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.148.0"
  },
  "packageManager": "pnpm@11.20.0"
}
