{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DotStories",
  "version": "0.1.0",
  "identifier": "com.dotstories.runner",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/uv"],
    "resources": {
      "../../engine/pyproject.toml": "engine/pyproject.toml",
      "../../engine/uv.lock": "engine/uv.lock",
      "../../engine/src/": "engine/src/"
    },
    "shortDescription": "Runs DotStories dots on your computer",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
